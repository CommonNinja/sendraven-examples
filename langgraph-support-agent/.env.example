# Anthropic API key (or sign in once with `ant auth login` and leave this empty). Placeholder only.
ANTHROPIC_API_KEY=sk-ant-replace_me
# claude-opus-5-5 by default; claude-sonnet-5 is the cheaper option.
CLAUDE_MODEL=claude-opus-5-5

# SendRaven. Scopes: threads:read and emails:send.
# Start with a key that has "Require approval" ticked (requires_approval: true): every reply the
# graph sends, including ones a reviewer approved at the interrupt, is then held again for a person
# in the dashboard. Add a daily send limit either way.
SENDRAVEN_API_KEY=sk_live_replace_me
SENDRAVEN_API_URL=

# The support address on your verified sending domain (the one with the inbound MX record).
SUPPORT_FROM=Acme Support <support@mail.example.com>

KNOWLEDGE_BASE=kb.md
# Below this confidence (0 to 1) a draft goes to a person instead of out.
MIN_CONFIDENCE=0.75
# Where LangGraph keeps its checkpoints, including runs paused for review.
CHECKPOINT_DB=support.sqlite
