# Anthropic API key. Placeholder only.
ANTHROPIC_API_KEY=sk-ant-replace_me
# claude-opus-5-5 by default; claude-sonnet-5 is the cheaper option.
CLAUDE_MODEL=claude-opus-5-5

# SendRaven. Scopes: threads:read and emails:send.
# Start with a key that has "Require approval" ticked (requires_approval: true): the requests and every
# reply the crew writes, including ones a reviewer approved, are then held for a person in the dashboard.
# Add a daily send limit either way.
SENDRAVEN_API_KEY=sk_live_replace_me
SENDRAVEN_API_URL=

# The purchasing address on your verified sending domain (the one with the inbound MX record).
PURCHASING_FROM=Acme Purchasing <purchasing@mail.example.com>
# Names this round of quotes. It goes in every subject, tag and idempotency key, so change it for the next round.
RFQ_ID=RFQ-2026-10-BOX

REQUEST=request.md
VENDORS=vendors.csv
# The ledger and CrewAI's saved flows, including runs paused for review.
QUOTES_DB=quotes.sqlite

# CrewAI telemetry and trace prompts are off: main.py sets these defaults before importing crewai.
# CREWAI_DISABLE_TELEMETRY=true
# CREWAI_TRACING_ENABLED=false
