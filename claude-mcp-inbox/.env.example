# Anthropic API key (or sign in once with `ant auth login` and leave this empty). Placeholder only.
ANTHROPIC_API_KEY=sk-ant-replace_me
# claude-opus-5 by default; claude-sonnet-5 is the cheaper option.
CLAUDE_MODEL=claude-opus-5

# A SendRaven API key created with "Require approval" ticked (requires_approval: true),
# scopes emails:send, emails:read, threads:read. Every reply Claude drafts waits for a person.
SENDRAVEN_API_KEY=sk_live_replace_me_with_an_approval_held_key

# The support address on your verified sending domain (the one with the inbound MX record).
SUPPORT_FROM=Acme Support <support@mail.example.com>

KNOWLEDGE_BASE=kb.md
# SENDRAVEN_MCP_URL=https://mcp.sendraven.ai/mcp
