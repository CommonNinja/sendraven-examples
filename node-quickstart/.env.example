# An API key from the dashboard (API keys). Placeholder only: never commit a real key.
# Scopes this example uses: emails:send, emails:read, threads:read (+ webhooks:write for webhook-register).
SENDRAVEN_API_KEY=sk_live_replace_me

# A sender on a domain verified in your workspace, e.g. a transactional subdomain.
SENDRAVEN_FROM=Acme Support <support@mail.example.com>

# Optional. Defaults to https://api.sendraven.ai
SENDRAVEN_API_URL=

# Printed once by `webhook-register`. Starts with whsec_.
SENDRAVEN_WEBHOOK_SECRET=whsec_replace_me
PORT=3000
