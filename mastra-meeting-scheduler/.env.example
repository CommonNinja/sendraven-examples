# Anthropic, for the two Mastra agents. Placeholder only.
ANTHROPIC_API_KEY=sk-ant-replace_me
# Any model id Mastra's model router accepts, as provider/model.
MODEL=anthropic/claude-sonnet-5-5

# SendRaven. Scopes: emails:send and threads:read.
# For an unattended agent, give this key a daily send limit and a recipient allowlist.
SENDRAVEN_API_KEY=sk_live_replace_me
SENDRAVEN_FROM=Sam at Acme <sam@mail.example.com>
SENDRAVEN_API_URL=

# Scheduling policy
AVAILABILITY_FILE=availability.json
MAX_ROUNDS=3
STATE_FILE=scheduler-state.json
MASTRA_DB_URL=file:./scheduler.db

# Webhook mode only. Printed once when the endpoint is created. Starts with whsec_.
SENDRAVEN_WEBHOOK_SECRET=whsec_replace_me
PORT=3000
