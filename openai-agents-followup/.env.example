# OpenAI, for the Agents SDK. Placeholder only.
OPENAI_API_KEY=sk-replace_me
# Optional: a model name. Unset uses the Agents SDK's default model.
OPENAI_MODEL=
# Set to 1 to stop the Agents SDK exporting traces to OpenAI.
OPENAI_AGENTS_DISABLE_TRACING=0

# SendRaven. Scopes: emails:send and threads:read.
# For an unattended agent, give this key a daily send limit and a recipient allowlist.
SENDRAVEN_API_KEY=sk_live_replace_me
SENDRAVEN_FROM=Dana at Acme <dana@mail.example.com>
SENDRAVEN_API_URL=

# Follow-up policy
FOLLOWUP_DELAY=3d
MAX_FOLLOWUPS=2
STATE_FILE=followups.json

# Webhook mode only. Printed once when the endpoint is created. Starts with whsec_.
SENDRAVEN_WEBHOOK_SECRET=whsec_replace_me
PORT=3000
